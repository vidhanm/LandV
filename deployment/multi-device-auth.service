[Unit]
Description=Multi-Device Authentication FastAPI Backend
After=network.target
Wants=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/multi-device-auth/backend
Environment=PATH=/home/ubuntu/multi-device-auth/backend/venv/bin
EnvironmentFile=/home/ubuntu/multi-device-auth/backend/.env
ExecStart=/home/ubuntu/multi-device-auth/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=multi-device-auth

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/home/ubuntu/multi-device-auth/backend

[Install]
WantedBy=multi-user.target